# ============================================================
# Unwinded CMS — Environment Configuration
# Copy this file to .env and fill in your values.
# The .env file must never be committed to version control.
# Store it outside the web root (chmod 600).
# ============================================================

# Application
APP_NAME="Unwinded"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://unwinded.co.za
APP_KEY=                          # Run bin/console key:generate to populate
APP_TIMEZONE=Africa/Johannesburg

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=unwinded_db
DB_USERNAME=unwinded_user
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Mail (Google Workspace SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_AUTH_METHOD=login            # login | xoauth2
MAIL_USERNAME=no-reply@unwinded.co.za
MAIL_PASSWORD=                    # App Password (never the Workspace account password)
MAIL_FROM_ADDRESS=no-reply@unwinded.co.za
MAIL_FROM_NAME="Unwinded"
MAIL_REPLY_TO=hello@unwinded.co.za
# OAuth2 (only when MAIL_AUTH_METHOD=xoauth2)
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=
MAIL_OAUTH_REFRESH_TOKEN=
# Development mail mode: live | log | catch_all
MAIL_MODE=live
MAIL_CATCH_ALL=dev@unwinded.co.za

# Payments — PayFast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true              # Set false in production
PAYFAST_ITN_URL=                  # https://unwinded.co.za/webhooks/payfast

# Tickets
TICKET_HMAC_KEY=                  # Run bin/console key:generate --key=ticket to populate

# Gallery
GALLERY_TOKEN_KEY=                # Pepper for gallery token hashing

# Cron security
CRON_SECRET=                      # Token for web-based cron fallback endpoint

# Storage
STORAGE_PRIVATE_PATH=             # Absolute path to storage/private (defaults to APP_ROOT/storage/private)

# SEO / Analytics
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
META_PIXEL_ID=

# Social
WHATSAPP_NUMBER=27000000000       # International format, no +
INSTAGRAM_URL=
FACEBOOK_URL=
