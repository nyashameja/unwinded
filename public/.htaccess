# ============================================================
# Unwinded CMS — Apache configuration for the web root
# ============================================================

Options -Indexes -ExecCGI +FollowSymLinks

# ── HTTPS redirect ────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (remove this block if SSL termination is upstream)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ── Front controller ───────────────────────────────────────
    # Allow real files and directories to be served directly.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# ── Block sensitive files ─────────────────────────────────────
<FilesMatch "\.(env|log|sql|md|json|lock|yaml|yml|ini|bak|swp|gitignore)$">
    Require all denied
</FilesMatch>

# Block hidden files (dotfiles) except the rewrite directives above.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ── Disable PHP execution in uploads ─────────────────────────
# (uploads/ has its own .htaccess; this is belt-and-suspenders)
<IfModule mod_php.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar)$">
        Require all denied
    </FilesMatch>
</IfModule>

# ── Cache headers for versioned assets ───────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|png|jpg|jpeg|webp|ico|gif)$">
        ExpiresDefault "access plus 1 year"
        Header append Cache-Control "public, immutable"
    </FilesMatch>
</IfModule>

# ── Security headers (also set by PHP; belt-and-suspenders) ──
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Charset ────────────────────────────────────────────────────
AddDefaultCharset UTF-8

# ── GZIP compression ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
</IfModule>
