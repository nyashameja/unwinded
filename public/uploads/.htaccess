# Prevent any PHP execution inside the uploads directory.
Options -ExecCGI -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar
RemoveType    .php .phtml

# Only allow image and PDF files to be accessed.
<FilesMatch "\.(?!jpg$|jpeg$|png$|webp$|gif$|pdf$)[^.]+$">
    Require all denied
</FilesMatch>
